# --- Vite dev server ---
# Port of the mobile client. Keep it different from `web/` (5173) so both apps
# can run at the same time without stealing each other's port.
WEB_PORT=5273

# Serve the dev server over HTTPS with a self-signed certificate.
#   - Enables `https://localhost:5273` on this machine.
#   - The generated certificate is ONLY valid for localhost / 127.0.0.1 / ::1,
#     so `https://<LAN-IP>:5273` still fails the hostname check. To use the
#     camera from a phone, expose the dev server through an HTTPS tunnel with a
#     real domain (see README) instead of fighting with local certificates.
#
# Prefer the script, which sets this in any shell:  npm run dev:https
# (PowerShell/cmd cannot do `HTTPS=1 npm run dev`.)
HTTPS=0

# --- Optional telemetry backend (mobile/server) ---
# Where `/api/*` is proxied in dev. The mobile client is fully functional
# without this server; it only relays detections to other devices.
API_URL=http://127.0.0.1:8787

# --- Hosts / tunnels ---
# By default the dev server accepts ANY Host header, because rejecting unknown
# hosts is what makes tunnels fail with "403 This host is not allowed".
# Set a comma-separated list to restrict it on untrusted networks:
# DEV_ALLOWED_HOSTS=abc123.tu-tunel.dev,192.168.1.47

# When serving through a tunnel, the HMR websocket must dial the public port.
# HMR_CLIENT_PORT=443

# --- ONNX Runtime assets ---
# By default NOTHING is set and Vite resolves the runtime itself, which is the
# only way to guarantee that the JS glue and the .wasm come from the same
# installed version. Do not set `wasmPaths` by hand: a version mismatch fails as
# a useless "no available backend found".
#
# Set this only to serve the runtime from elsewhere:
#   · `cdn`               -> jsDelivr, with the installed version injected (ideal
#                            para túneles: el wasm son 28 MB y no es comprimible)
#   · a local directory   -> /ort/   (populated by `npm run sync:ort`)
# NOTE: `/ort/` only works when the app is served by `server/index.mjs`. Through
# the Vite dev server, Vite rewrites ORT's dynamic import into `…mjs?import` and
# the load fails.
# VITE_ORT_ASSET_BASE=cdn

# --- Modelo ONNX ---
# Modelo cargado automáticamente al arrancar. Por defecto `/models/best.onnx`,
# que `npm run sync:models` copia desde la raíz del repo (junto a su sidecar
# `best.labels.txt` con los nombres de clase). Si no existe, la app arranca sin
# modelo y no muestra ningún error.
# VITE_DEFAULT_MODEL_URL=/models/best.onnx

# Ponlo a 0 para no cargar el modelo al arrancar (38 MB): útil si la primera
# visita va por un túnel lento y prefieres lanzarlo desde la UI.
# VITE_AUTOLOAD_MODEL=0

# --- Servidor standalone (node server/index.mjs) ---
# Lo lee `npm run server` / `npm run serve` / `npm start` mediante
# `node --env-file-if-exists=.env.local`, y también Vite (variables VITE_*).
# PORT=8787          # el puerto que publica el túnel
# SERVE_DIST=1       # sirve el SPA compilado además de la API

# --- Modelo 3D del gemelo digital ---
# Por defecto `/models/OC4.glb` (copiado por `npm run sync:models`).
# VITE_TWIN_MODEL_URL=/models/OC4.glb
