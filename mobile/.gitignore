# Dependencies / build output
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# --- Standalone assets (never versioned: synced from the main repo) ---
# 3D models: `npm run sync:models` copies them from ../web/public/models
public/models/*.glb
public/models/*.fbx
public/models/*.onnx

# Excepción a lo anterior: lo mínimo para que un clon arranque con solo
# `npm install`. El gemelo 3D, el modelo por defecto (nano 200 ft4, fp32),
# el small 640 fp32 para comparar y la variante int8 rápida del 640.
!public/models/OC4.glb
!public/models/yolo-pose-n-200.onnx
!public/models/yolo-pose-s-coco-640.onnx
!public/models/yolo-pose-n-640-int8.onnx

# Notas de despliegue con datos reales del servidor (host, dominio, nginx).
# DEPLOY.md es la guía genérica y sí se versiona.
DEPLOY.local.md
# ONNX Runtime WASM binaries: `npm run sync:ort` copies them from node_modules
public/ort/

# Source weights (`scripts/export-onnx.py` turns these into public/models/*.onnx)
models/*.pt
# Descargas de Drive (dataset partido en trozos de ~2 GB)
models/*.zip

# Telemetry dumps
server/data/
*.log
logs
