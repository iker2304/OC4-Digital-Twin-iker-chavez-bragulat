{
    "name": "oc4-mobile-standalone",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Standalone mobile/landscape client: on-device ONNX inference + three.js digital twin overlaid on the camera feed.",
    "scripts": {
        "sync:models": "node scripts/sync-models.mjs",
        "sync:ort": "node scripts/sync-ort.mjs",
        "postinstall": "node scripts/sync-ort.mjs",
        "predev": "node scripts/sync-models.mjs",
        "dev": "vite --host",
        "dev:https": "node scripts/dev-variant.mjs --https",
        "dev:tunnel": "node scripts/dev-variant.mjs --tunnel",
        "prebuild": "node scripts/sync-models.mjs",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host",
        "typecheck": "tsc -b",
        "verify:inference": "esbuild scripts/verify-inference.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-inference.mjs --log-level=warning && node node_modules/.tmp/verify-inference.mjs",
        "verify:pose": "esbuild scripts/verify-pose.mts --bundle --platform=node --format=esm --external:three --outfile=node_modules/.tmp/verify-pose.mjs --log-level=warning && node node_modules/.tmp/verify-pose.mjs",
        "verify:frame": "esbuild scripts/verify-frame.mts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify-frame.mjs --log-level=warning && node node_modules/.tmp/verify-frame.mjs",
        "inspect:model": "node scripts/inspect-model.mjs",
        "server": "node --env-file-if-exists=.env.local server/index.mjs",
        "serve": "node --env-file-if-exists=.env.local server/index.mjs --serve-dist",
        "start": "npm run build && npm run serve",
        "verify:photo": "esbuild scripts/verify-photo.mts --bundle --platform=node --format=esm --external:@napi-rs/canvas --alias:onnxruntime-web=onnxruntime-web/wasm --outfile=node_modules/.tmp/verify-photo.mjs --log-level=warning && node node_modules/.tmp/verify-photo.mjs",
        "find:mapping": "esbuild scripts/find-mapping.mts --bundle --platform=node --format=esm --external:@napi-rs/canvas --alias:onnxruntime-web=onnxruntime-web/wasm --outfile=node_modules/.tmp/find-mapping.mjs --log-level=warning && node node_modules/.tmp/find-mapping.mjs",
        "bench:model": "esbuild scripts/bench-model.mts --bundle --platform=node --format=esm --alias:onnxruntime-web=onnxruntime-web/wasm --outfile=node_modules/.tmp/bench-model.mjs --log-level=warning && node node_modules/.tmp/bench-model.mjs"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "clsx": "^2.1.1",
        "compression": "^1.7.5",
        "express": "^4.21.2",
        "lucide-react": "^0.564.0",
        "onnxruntime-web": "^1.30.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.4.0",
        "three": "^0.182.0",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@napi-rs/canvas": "^1.0.11",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.24",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "typescript": "~5.9.3",
        "vite": "^7.2.4"
    }
}
